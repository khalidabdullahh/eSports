# ============================================================
# ARENEX v2.0 — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env.local for local development.
# NEVER commit .env or .env.local to GitHub.
# ============================================================

# Supabase Public API (Accessible in browser and server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key-here
# Optional newer Supabase naming standard alias:
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-public-publishable-key-here

# Server-Only Privileged Secret (NEVER expose to client / NEVER use NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key-here

# Platform Base Canonical URL
NEXT_PUBLIC_APP_URL=https://esports-jade.vercel.app
